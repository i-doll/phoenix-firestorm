<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
  legacy_header_height="18"
  bevel_style="none"
  border_style="line"
  can_resize="true"
  height="602"
  layout="topleft"
  min_height="271"
  min_width="328"
  name="script ed float"
  help_topic="preview_lsl_text"
  save_rect="true"
  title="Script: New script"
  width="508">
  <floater.string
    name="not_allowed">
    You can not view or edit this script, since it has been set with restricted permissions. You need full permissions to view or edit a script inside an object.
  </floater.string>
  <floater.string
    name="script_running">
    Running
  </floater.string>
  <floater.string
    name="Title">
    Script: [NAME]
  </floater.string>
  <floater.string
    name="experience_enabled">
    Uncheck to remove the current experience
  </floater.string>
  <floater.string
    name="no_experiences">
    You are not authorized for any experiences
  </floater.string>
  <floater.string
    name="add_experiences">
    Select to add an experience
  </floater.string>
  <floater.string
    name="show_experience_profile">
    Click to view the experience profile
  </floater.string>
  <floater.string
    name="loading">
    Loading...
  </floater.string>
  <text
   type="string"
   length="1"
   follows="left|top|right"
   width="490"
   use_ellipses="true"
   font="SansSerif"
   height="15"
   layout="topleft"
   left="13"
   name="obj_name"
   top="21">
     Source object: [SOURCE_OBJECT]
  </text>
  <panel
    bevel_style="none"
     
    border_style="line"
    follows="left|top|right|bottom"
    layout="topleft"
    left="10"
    name="script ed panel"
    right="-10"
    top="38"
    bottom="-60" />
  <button
    follows="left|bottom"
    bottom="-4"
    height="23"
    label="Reset"
    label_selected="Reset"
    layout="topleft"
    left="10"
    name="Reset"
    width="85" />
  <check_box
    follows="left|bottom"
    bottom="-6"
    enabled="false"
    font="SansSerif"
    height="18"
    initial_value="true"
    label="Running"
    layout="topleft"
    left="100"
    name="running"
    width="205" />
  <check_box
    follows="bottom|left"
    bottom="-30"
    enabled="false"
    height="21"
    label="Use Experience:"
    layout="topleft"
    left="9"
    name="enable_xp"
    width="130" />
  <combo_box
    label=""
    bottom="-30"
    layout="topleft"
    follows="left|bottom|right"
    left="149"
    right="467"
    visible="false"
    name="Experiences..."/>
  <button label="&gt;"
          name="view_profile"
          height="23"
          width="23"
          right="496"
          layout="topleft"
          bottom="-28"
          follows="right"
          visible="false"/>
</floater>
