<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<floater
 legacy_header_height="18"
 can_resize="true"
 height="400"
 layout="topleft"
 name="queue"
 help_topic="script_queue"
 save_rect="true"
 title="Recompilation Progress"
 width="300">
    <floater.string
     name="Starting">
        Starting [START] of [COUNT] items.
    </floater.string>
    <floater.string
     name="Done">
        Done.
    </floater.string>
    <floater.string
     name="Resetting">
        Resetting
    </floater.string>
    <floater.string
     name="Running">
        Running
    </floater.string>
    <floater.string
     name="NotRunning">
        Not running
    </floater.string>
    <floater.string
     name="Timeout">
        Timeout: [OBJECT_NAME]
    </floater.string>
    <floater.string
     name="LoadingObjInv">
        Loading inventory for: [OBJECT_NAME]
    </floater.string>
    <floater.string
        name="Deleting">
      Deleting
    </floater.string>
    <floater.string
        name="SkippingPermissions">
      Skipping: [OBJECT_NAME] (Permissions)
    </floater.string>
    <floater.string
        name="Compiling">
      Compiling "[OBJECT_NAME]"...
    </floater.string>
    <floater.string
        name="CompileSuccess">
      Compilation of "[OBJECT_NAME]" succeeded
    </floater.string>
    <floater.string
        name="CompileFailure">
      Compilation of "[OBJECT_NAME]" failed:
    </floater.string>

    <combo_box
      follows="left|top"
      height="23"
      label="Compile target"
      layout="topleft"
      left="4"
      name="compile_target"
      top="20"
      width="140" />

    <scroll_list
     follows="left|top|right|bottom"
     draw_stripes="false"
     height="314"
     layout="topleft"
     left="4"
     name="queue output"
     top="50"
     width="292" />

    <button
     follows="right|bottom"
     height="24"
     label="Close"
     label_selected="Close"
     layout="topleft"
     left="220"
     name="close"
     top="368"
     width="64" />
</floater>
