     follows="left|top"
     font.style="UNDERLINE"
     height="15"
     layout="topleft"
     left="30"
     mouse_opaque="true"
     name="custom_accent_link"
     text_color="TextFgReadOnlyColor"
     text_readonly_color="TextFgReadOnlyColor"
     top_pad="12"
     width="120">
        Custom colour…
    </text>
    <color_swatch
     can_apply_immediately="true"
     follows="left|top"
     height="24"
     label_height="0"
     layout="topleft"
     left="30"
     name="custom_accent_swatch"
     top_pad="0"
     visible="false"
     width="44" />
</panel>
