<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<floater
 can_minimize="false"
 height="300"
 layout="topleft"
 legacy_header_height="18"
 name="rlva_strings"
 title="RLVa Strings"
 width="400">
    <tab_container
     follows="all"
     height="275"
     layout="topleft"
     left="5"
     name="string_tabs"
     tab_position="top"
     top="25"
     width="390">
        <!-- Customizable Strings Tab -->
        <panel
         label="Strings"
         layout="topleft"
         name="strings_panel">
            <combo_box
             allow_text_entry="false"
             follows="top|left|right"
             height="22"
             layout="topleft"
             left="8"
             max_chars="255"
             name="string_list"
             top="8"
             width="370" />
            <text_editor
             enabled="false"
             follows="top|left|right"
             height="60"
             layout="topleft"
             left_delta="0"
             name="string_descr"
             top_pad="5"
             width="370"
             word_wrap="true" />
            <text_editor
             enabled="true"
             follows="top|left|right"
             height="60"
             layout="topleft"
             left_delta="0"
             name="string_value"
             top_pad="5"
             width="370"
             word_wrap="true" />
            <button
             follows="bottom|left"
             height="23"
             label="Reset to default"
             layout="topleft"
             left="8"
             name="default_btn"
             top_pad="10"
             width="140">
                <button.commit_callback
                 function="ClickDefault" />
            </button>
        </panel>
        <!-- Blocked IM Messages Tab -->
        <panel
         label="Blocked IM Messages"
         layout="topleft"
         name="blocked_im_panel">
            <text
             follows="top|left"
             height="16"
             layout="topleft"
             left="8"
             name="blocked_im_label"
             top="8"
             width="370">
                Messages sent when @sendim=n is active (random selection):
            </text>
            <scroll_list
             draw_heading="false"
             follows="top|left|right"
             height="150"
             layout="topleft"
             left="8"
             multi_select="false"
             name="blocked_im_list"
             top_pad="5"
             width="370">
                <scroll_list.columns
                 label="Message"
                 name="message"
                 width="365" />
            </scroll_list>
            <line_editor
             follows="top|left|right"
             height="22"
             layout="topleft"
             left="8"
             max_length_bytes="255"
             name="blocked_im_input"
             top_pad="8"
             width="370" />
            <button
             follows="top|left"
             height="23"
             label="Add"
             layout="topleft"
             left="8"
             name="blocked_im_add_btn"
             top_pad="5"
             width="80" />
            <button
             follows="top|left"
             height="23"
             label="Remove"
             layout="topleft"
             left_pad="5"
             name="blocked_im_remove_btn"
             width="80" />
            <button
             follows="top|left"
             height="23"
             label="Reset to default"
             layout="topleft"
             left_pad="5"
             name="blocked_im_reset_btn"
             width="110" />
        </panel>
    </tab_container>
</floater>
